{
  "name": "tracework",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src server shared tests desktop scripts docs README.md vite.config.ts electron-builder.config.cjs",
    "mcp": "tsx server/mcp-cli.ts",
    "desktop:prepare": "node scripts/prepare-runtime.mjs",
    "desktop:build": "npm run build && npm run desktop:prepare && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --dir",
    "desktop:dist": "npm run desktop:build && electron-builder --config electron-builder.config.cjs",
    "desktop:verify": "node scripts/verify-desktop.mjs",
    "desktop:test": "tsx --test tests/desktop.integration.ts",
    "desktop:smoke": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "desktop/main.cjs",
  "description": "Local coding-agent session intelligence for engineers.",
  "author": "Tracework",
  "license": "UNLICENSED"
}
